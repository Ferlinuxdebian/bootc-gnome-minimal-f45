# /etc/systemd/system/post-install.service
# Instala os Flatpaks listados em /usr/share/flatpak/preinstall.d/ na instalação do usuário

[Unit]
Description=Instalação de Flatpaks iniciais (flatpak preinstall)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/fernando

[Service]
Type=oneshot
User=fernando
ExecStartPre=-+/usr/bin/flatpak remote-delete --system --force fedora
ExecStartPre=/usr/bin/flatpak remote-add --user --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
ExecStart=/usr/bin/flatpak preinstall --user -y --noninteractive

[Install]
WantedBy=graphical.target
